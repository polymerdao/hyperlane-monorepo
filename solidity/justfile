ADDRESS_PATH := "./devnet-addresses.json"
TRON_DEPLOYMENTS_PATH := "./tron-deployment"

chain-id RPC_URL:
  @echo "$(cast chain-id -r {{RPC_URL}})"

# The deploy-mailbox recipe now uses the variable
deploy-mailbox RPC_URL ADDRESS_PATH="./devnet-addresses.json":
    echo "Using deployer account $(cast wallet address $PRIVATE_KEY)"
    export HYPERLANE_DOMAIN_ID=$(just chain-id "{{RPC_URL}}") && \
    export DEFAULT_ISM=$(just default-ism "{{RPC_URL}}" "{{ADDRESS_PATH}}") && \
    forge script script/DeployMailbox.s.sol:DeployMailbox \
        --rpc-url "{{RPC_URL}}" \
        --broadcast \
        -vvvv | tee /tmp/deploy-Mailbox.txt && \
    export MAILBOX_ADDRESS=$(grep -o 'new ERC1967Proxy@0x[a-fA-F0-9]*' /tmp/deploy-Mailbox.txt | cut -d'@' -f2)
    just save-contract-address "{{RPC_URL}}" "Mailbox" "Mailbox" "ERC1967Proxy" "{{ADDRESS_PATH}}"

# Should only really be needed for the hub chain and run once per environment. 
deploy-routing-ism RPC_URL ADDRESS_PATH="./devnet-addresses.json":
    forge script script/DeployDomainRoutingIsm.s.sol:DeployDomainRoutingIsm \
        --rpc-url "{{RPC_URL}}" \
        --broadcast \
        -vvvv | tee /tmp/deploy-DomainRoutingIsm.txt && \
    echo "DomainRoutingIsm deployed at: $(grep -o 'new DomainRoutingIsm@0x[a-fA-F0-9]*' /tmp/deploy-DomainRoutingIsm.txt | cut -d'@' -f2)"
    just save-contract-address "{{RPC_URL}}" "DomainRoutingIsm" "DomainRoutingIsm" "DomainRoutingIsm" "{{ADDRESS_PATH}}"

deploy-polymerism ORIGIN_CHAIN_ID RPC_URL ADDRESS_PATH="./devnet-addresses.json":
    POLYMER_PROVER_ADDRESS="${POLYMER_PROVER_ADDRESS:? polymer prover address must be set in the environment}" 
    echo "Using deployer account $(cast wallet address $PRIVATE_KEY)" 
    export ORIGIN_MAILBOX_ADDRESS=$(just get-contract {{ORIGIN_CHAIN_ID}} Mailbox "{{ADDRESS_PATH}}") && \
    export ORIGIN_CHAIN_ID={{ORIGIN_CHAIN_ID}} && \
    forge script script/DeployPolymerIsm.s.sol:DeployPolymerIsm \
        --rpc-url "{{RPC_URL}}" \
        --broadcast \
        -vvvv | tee /tmp/deploy-PolymerISM.txt && \
    echo "Polymerism deployed at: $(grep -o 'new PolymerISM@0x[a-fA-F0-9]*' /tmp/deploy-PolymerISM.txt | cut -d'@' -f2)"
    just save-contract-address "{{RPC_URL}}" "PolymerISM_{{ORIGIN_CHAIN_ID}}" "PolymerISM" "PolymerISM" "{{ADDRESS_PATH}}"

configure-routing-ism ORIGIN_CHAIN_ID RPC_URL ADDRESS_PATH="./devnet-addresses.json":
    export CHAIN_ID=$(just chain-id "{{RPC_URL}}") && \
    export ORIGIN_DOMAIN={{ORIGIN_CHAIN_ID}} && \
    export DOMAIN_ROUTING_ISM_ADDRESS=$(just get-contract $CHAIN_ID "DomainRoutingIsm" "{{ADDRESS_PATH}}") && \
    export ISM_ADDRESS=$(just get-contract $CHAIN_ID "PolymerISM_{{ORIGIN_CHAIN_ID}}" "{{ADDRESS_PATH}}") && \
    echo "Configuring DomainRoutingIsm at: $DOMAIN_ROUTING_ISM_ADDRESS for origin $ORIGIN_DOMAIN with ISM: $ISM_ADDRESS" && \
    forge script script/configureDomainRoutingIsm.s.sol:ConfigureDomainRoutingIsm \
        --rpc-url "{{RPC_URL}}" \
        --broadcast \
        -vvvv

deploy-new-spoke-chain SPOKE_RPC_URL HUB_RPC_URL ADDRESS_PATH="./devnet-addresses.json":
    echo "Deploying new spoke chain..."
    export SPOKE_CHAIN_ID=$(just chain-id "{{SPOKE_RPC_URL}}") && \
    export HUB_CHAIN_ID=$(just chain-id "{{HUB_RPC_URL}}") && \
    echo "Spoke Chain ID: $SPOKE_CHAIN_ID, Hub Chain ID: $HUB_CHAIN_ID" && \
    echo "Step 1: Deploying mailbox on spoke chain..." && \
    just deploy-mailbox "{{SPOKE_RPC_URL}}" "{{ADDRESS_PATH}}" && \
    echo "Step 2: Deploying PolymerISM on spoke chain with hub as origin..." && \
    just deploy-polymerism $HUB_CHAIN_ID "{{SPOKE_RPC_URL}}" "{{ADDRESS_PATH}}" && \
    echo "Step 3: Deploying PolymerISM on hub chain with spoke as origin..." && \
    just deploy-polymerism $SPOKE_CHAIN_ID "{{HUB_RPC_URL}}" "{{ADDRESS_PATH}}" && \
    echo "Step 4: Deploying simple app on spoke chain..." && \
    just deploy-simple-app "{{SPOKE_RPC_URL}}" $HUB_CHAIN_ID "{{ADDRESS_PATH}}" && \
    echo "Spoke chain deployment complete!"

# Deploy new hub chain typically implies that you will also need to deploy at least one other spoke chain
deploy-new-hub-chain HUB_RPC_URL SPOKE_RPC_URL ADDRESS_PATH="./devnet-addresses.json":
    echo "Deploying new hub chain..."
    export HUB_CHAIN_ID=$(just chain-id "{{HUB_RPC_URL}}") && \
    export SPOKE_CHAIN_ID=$(just chain-id "{{SPOKE_RPC_URL}}") && \
    echo "Hub Chain ID: $HUB_CHAIN_ID, Spoke Chain ID: $SPOKE_CHAIN_ID" && \
    echo "Step 1: Deploying DomainRoutingISM on hub chain..." && \
    just deploy-routing-ism "{{HUB_RPC_URL}}" "{{ADDRESS_PATH}}" && \
    echo "Step 2: Deploying mailbox on hub chain..." && \
    just deploy-mailbox "{{HUB_RPC_URL}}" "{{ADDRESS_PATH}}" && \
    echo "Step 3: Deploying PolymerISM on spoke chain with hub as origin..." && \
    just deploy-polymerism $HUB_CHAIN_ID "{{SPOKE_RPC_URL}}" "{{ADDRESS_PATH}}" && \
    echo "Step 4: Deploying mailbox on spoke chain..." && \
    just deploy-mailbox "{{SPOKE_RPC_URL}}" "{{ADDRESS_PATH}}" && \
    echo "Step 5: Deploying PolymerISM on hub chain with spoke as origin..." && \
    just deploy-polymerism $SPOKE_CHAIN_ID "{{HUB_RPC_URL}}" "{{ADDRESS_PATH}}" && \
    echo "Step 5: Configuring DomainRoutingISM to use PolymerISM for spoke chain..." && \
    just configure-routing-ism $SPOKE_CHAIN_ID "{{HUB_RPC_URL}}" "{{ADDRESS_PATH}}" && \
    echo "Step 5: Deploying simple app on hub chain..." && \
    just deploy-simple-app "{{HUB_RPC_URL}}" $SPOKE_CHAIN_ID "{{ADDRESS_PATH}}" && \
    echo "Hub chain deployment complete!" && \
    echo "Step 6: Deploying simple app on spoke chain..." && \
    just deploy-simple-app "{{SPOKE_RPC_URL}}" $HUB_CHAIN_ID "{{ADDRESS_PATH}}" && \
    echo "Spoke chain deployment complete!"

deploy-simple-app RPC_URL ORIGIN_CHAIN_ID ADDRESS_PATH="./devnet-addresses.json":
    export CHAIN_ID=$(just chain-id "{{RPC_URL}}") && \
    export MAILBOX_ADDRESS=$(just get-contract $CHAIN_ID Mailbox "{{ADDRESS_PATH}}") && \
    export ISM_ADDRESS=$(just default-ism "{{RPC_URL}}" "{{ADDRESS_PATH}}") && \
    forge script script/DeploySimpleMessageSenderReceiver.s.sol:DeploySimpleMessageSenderReceiver \
        --rpc-url "{{RPC_URL}}" \
        --broadcast \
        -vvvv | tee /tmp/deploy-SimpleMessageSenderReceiver.txt && \
    echo "Simple app deployed at: $(grep -o 'new SimpleMessageSenderReceiver@0x[a-fA-F0-9]*' /tmp/deploy-SimpleMessageSenderReceiver.txt | cut -d'@' -f2)"
    just save-contract-address "{{RPC_URL}}" "SimpleMessageSenderReceiver_{{ORIGIN_CHAIN_ID}}" "SimpleMessageSenderReceiver" "SimpleMessageSenderReceiver" "{{ADDRESS_PATH}}"

save-contract-address RPC_URL CONTRACT_NAME DEPLOY_FILE_NAME CONTRACT_PATTERN ADDRESS_PATH="./devnet-addresses.json":
    export CONTRACT_ADDRESS=$(just _get-latest-address {{DEPLOY_FILE_NAME}} "{{CONTRACT_PATTERN}}") && \
    export CHAIN_ID=$(just chain-id "{{RPC_URL}}") && \
    jq --arg address "$CONTRACT_ADDRESS" \
       --arg chain_id "$CHAIN_ID" \
       --arg contract_name "{{CONTRACT_NAME}}" \
       '.[$chain_id] |= ( . + {($contract_name): $address} )' "{{ADDRESS_PATH}}" > "{{ADDRESS_PATH}}.tmp" && mv "{{ADDRESS_PATH}}.tmp" "{{ADDRESS_PATH}}"

get-contract CHAIN_ID CONTRACT_NAME ADDRESS_PATH="./devnet-addresses.json":
    @cat "{{ADDRESS_PATH}}" | jq -r --arg chain_id "{{CHAIN_ID}}" '.[$chain_id].{{CONTRACT_NAME}}'

default-ism RPC_URL ADDRESS_PATH="./devnet-addresses.json":
    @export CHAIN_ID=$(just chain-id "{{RPC_URL}}") && \
    if [ "$CHAIN_ID" = "25327" ] || [ "$CHAIN_ID" = "84532" ]; then \
        just get-contract $CHAIN_ID "DomainRoutingIsm" "{{ADDRESS_PATH}}"; \
    elif [ "$CHAIN_ID" = "11155111" ] || [ "$CHAIN_ID" = "3448148188" ]; then \
        just get-contract $CHAIN_ID "PolymerISM_84532" "{{ADDRESS_PATH}}"; \
    else \
        just get-contract $CHAIN_ID "PolymerISM_25327" "{{ADDRESS_PATH}}"; \
    fi


# TRON DEPLOYMENTS
tron-build:
    cd "{{TRON_DEPLOYMENTS_PATH}}" && just build-contract

# Deploy mailbox on TRON (migrations 1-2) and save addresses
tron-deploy-mailbox RPC_URL ADDRESS_PATH="./addresses/devnet-addresses.json":
    echo "Using deployer account $(cast wallet address $PRIVATE_KEY)"
    export HYPERLANE_DOMAIN_ID=$(just chain-id "{{RPC_URL}}"/jsonrpc) && \
    cd "{{TRON_DEPLOYMENTS_PATH}}" && RPC_URL="{{RPC_URL}}" npx tronbox migrate --network dynamic --to 2 | tee /tmp/deploy-tron-mailbox.txt
    just save-contract-address "{{RPC_URL}}"/jsonrpc "Mailbox" "tron-mailbox" "Mailbox Proxy Address: 41[a-fA-F0-9]*" "{{ADDRESS_PATH}}"

# Deploy PolymerISM on TRON and save address
tron-deploy-polymerism PROVER_ADDRESS ORIGIN_MAILBOX_ADDRESS RPC_URL ADDRESS_PATH="./addresses/devnet-addresses.json":
    POLYMER_PROVER_ADDRESS="${POLYMER_PROVER_ADDRESS:? polymer prover address must be set in the environment}" 
    echo "Using deployer account $(cast wallet address $PRIVATE_KEY)"
    cd "{{TRON_DEPLOYMENTS_PATH}}" && RPC_URL="{{RPC_URL}}" POLYMER_PROVER_ADDRESS={{PROVER_ADDRESS}} ORIGIN_CHAIN_MAILBOX_ADDRESS={{ORIGIN_MAILBOX_ADDRESS}} npx tronbox migrate --network dynamic -f 3 --to 3 | tee /tmp/deploy-tron-polymerism.txt
    just save-contract-address "{{RPC_URL}}"/jsonrpc "PolymerISM" "tron-polymerism" "PolymerISM deployed at: 41[a-fA-F0-9]*" "{{ADDRESS_PATH}}"

# Deploy SimpleMessageSenderReceiver on TRON and save address
tron-deploy-simplesender-receiver MAILBOX_ADDRESS ISM_ADDRESS RPC_URL ADDRESS_PATH="./addresses/devnet-addresses.json":
    echo "Using deployer account $(cast wallet address $PRIVATE_KEY)"
    cd "{{TRON_DEPLOYMENTS_PATH}}" && RPC_URL="{{RPC_URL}}" MAILBOX_PROXY_ADDRESS={{MAILBOX_ADDRESS}} POLYMER_ISM_ADDRESS={{ISM_ADDRESS}} npx tronbox migrate --network dynamic -f 4 --to 4 | tee /tmp/deploy-tron-simplesender.txt
    just save-contract-address "{{RPC_URL}}"/jsonrpc "SimpleMessageSenderReceiver" "tron-simplesender" "SimpleMessageSenderReceiver deployed at: 41[a-fA-F0-9]*" "{{ADDRESS_PATH}}"

# Deploy new TRON spoke chain (full deployment sequence)
deploy-new-tron-spoke-chain PROVER_ADDRESS HUB_MAILBOX_ADDRESS RPC_URL ADDRESS_PATH="./addresses/devnet-addresses.json":
    echo "Deploying new TRON spoke chain..."
    export TRON_DOMAIN_ID=$(just chain-id "{{RPC_URL}}"/jsonrpc) && \
    echo "TRON Domain ID: $TRON_DOMAIN_ID" && \
    echo "Step 1: Building TRON contracts..." && \
    just tron-build && \
    echo "Step 2: Deploying mailbox on TRON..." && \
    just tron-deploy-mailbox "{{RPC_URL}}" "{{ADDRESS_PATH}}" && \
    echo "Step 3: Deploying PolymerISM on TRON..." && \
    export TRON_MAILBOX=$(just get-contract $TRON_DOMAIN_ID Mailbox "{{ADDRESS_PATH}}") && \
    just tron-deploy-polymerism "{{PROVER_ADDRESS}}" "{{HUB_MAILBOX_ADDRESS}}" "{{RPC_URL}}" "{{ADDRESS_PATH}}" && \
    echo "Step 4: Deploying SimpleMessageSenderReceiver on TRON..." && \
    export TRON_ISM=$(just get-contract $TRON_DOMAIN_ID PolymerISM "{{ADDRESS_PATH}}") && \
    just tron-deploy-simplesender-receiver $TRON_MAILBOX $TRON_ISM "{{RPC_URL}}" "{{ADDRESS_PATH}}" && \
    echo "TRON spoke chain deployment complete!"

# INTERNAL METHODS
_get-latest-address DEPLOY_FILE_NAME CONTRACT_PATTERN:
    @if [[ "{{DEPLOY_FILE_NAME}}" == tron-* ]]; then \
        @grep -o "{{CONTRACT_PATTERN}}" /tmp/deploy-{{DEPLOY_FILE_NAME}}.txt | cut -d' ' -f4 | head -1 || echo "No {{CONTRACT_PATTERN}} address found. Run deploy-{{CONTRACT_PATTERN}} first."; \
    else \
        @grep -o "new {{CONTRACT_PATTERN}}@0x[a-fA-F0-9]*" /tmp/deploy-{{DEPLOY_FILE_NAME}}.txt | head -1 | cut -d'@' -f2 || echo "No {{CONTRACT_PATTERN}} address found. Run deploy-{{CONTRACT_PATTERN}} first."
    fi

