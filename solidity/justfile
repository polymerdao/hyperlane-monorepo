ADDRESS_PATH := "./devnet-addresses.json"

chain-id RPC_URL:
  @echo "$(cast chain-id -r {{RPC_URL}})"

# The deploy-mailbox recipe now uses the variable
deploy-mailbox RPC_URL ADDRESS_PATH="./devnet-addresses.json":
    echo "Using deployer account $(cast wallet address $PRIVATE_KEY)"
    export HYPERLANE_DOMAIN_ID=$(just chain-id "{{RPC_URL}}") && \
    forge script script/DeployMailbox.s.sol:DeployMailbox \
        --rpc-url "{{RPC_URL}}" \
        --broadcast \
        -vvvv | tee /tmp/deploy-Mailbox.txt && \
    export MAILBOX_ADDRESS=$(grep -o 'new ERC1967Proxy@0x[a-fA-F0-9]*' /tmp/deploy-Mailbox.txt | cut -d'@' -f2)
    just save-contract-address "{{RPC_URL}}" "Mailbox" "Mailbox" "ERC1967Proxy" "{{ADDRESS_PATH}}"

# Should only really be needed for the hub chain and run once per environment. 
deploy-routing-ism ORIGIN_CHAIN_ID RPC_URL ADDRESS_PATH="./devnet-addresses.json":
    export CHAIN_ID=$(just chain-id "{{RPC_URL}}") && \
    export REMOTE_ORIGIN_DOMAIN_ID="{{ ORIGIN_CHAIN_ID }}" && \
    export POLYMER_ISM_FOR_REMOTE_ORIGIN_ADDRESS=$(just get-contract $CHAIN_ID "PolymerISM_{{ ORIGIN_CHAIN_ID }}" "{{ADDRESS_PATH}}") && \
    echo "Using PolymerISM at: $POLYMER_ISM_FOR_REMOTE_ORIGIN_ADDRESS" && \
    forge script script/DeployDomainRoutingIsm.s.sol:DeployDomainRoutingIsm \
        --rpc-url "{{RPC_URL}}" \
        --broadcast \
        -vvvv | tee /tmp/deploy-DomainRoutingIsm.txt && \
    echo "DomainRoutingIsm deployed at: $(grep -o 'new DomainRoutingIsm@0x[a-fA-F0-9]*' /tmp/deploy-DomainRoutingIsm.txt | cut -d'@' -f2)"
    just save-contract-address "{{RPC_URL}}" "DomainRoutingIsm" "DomainRoutingIsm" "DomainRoutingIsm" "{{ADDRESS_PATH}}"

deploy-polymerism ORIGIN_CHAIN_ID RPC_URL ADDRESS_PATH="./devnet-addresses.json":
    POLYMER_PROVER_ADDRESS="${POLYMER_PROVER_ADDRESS:? polymer prover address must be set in the environment}" 
    echo "Using deployer account $(cast wallet address $PRIVATE_KEY)" 
    export ORIGIN_MAILBOX_ADDRESS=$(just get-contract {{ORIGIN_CHAIN_ID}} Mailbox "{{ADDRESS_PATH}}") && \
    export ORIGIN_CHAIN_ID={{ORIGIN_CHAIN_ID}} && \
    forge script script/DeployPolymerIsm.s.sol:DeployPolymerIsm \
        --rpc-url "{{RPC_URL}}" \
        --broadcast \
        -vvvv | tee /tmp/deploy-PolymerISM.txt && \
    echo "Polymerism deployed at: $(grep -o 'new PolymerISM@0x[a-fA-F0-9]*' /tmp/deploy-PolymerISM.txt | cut -d'@' -f2)"
    just save-contract-address "{{RPC_URL}}" "PolymerISM_{{ORIGIN_CHAIN_ID}}" "PolymerISM" "PolymerISM" "{{ADDRESS_PATH}}"

deploy-new-spoke-chain SPOKE_RPC_URL HUB_RPC_URL ADDRESS_PATH="./devnet-addresses.json":
    echo "Deploying new spoke chain..."
    export SPOKE_CHAIN_ID=$(just chain-id "{{SPOKE_RPC_URL}}") && \
    export HUB_CHAIN_ID=$(just chain-id "{{HUB_RPC_URL}}") && \
    echo "Spoke Chain ID: $SPOKE_CHAIN_ID, Hub Chain ID: $HUB_CHAIN_ID" && \
    echo "Step 1: Deploying mailbox on spoke chain..." && \
    just deploy-mailbox "{{SPOKE_RPC_URL}}" "{{ADDRESS_PATH}}" && \
    echo "Step 2: Deploying PolymerISM on spoke chain with hub as origin..." && \
    just deploy-polymerism $HUB_CHAIN_ID "{{SPOKE_RPC_URL}}" "{{ADDRESS_PATH}}" && \
    echo "Step 3: Deploying PolymerISM on hub chain with spoke as origin..." && \
    just deploy-polymerism $SPOKE_CHAIN_ID "{{HUB_RPC_URL}}" "{{ADDRESS_PATH}}" && \
    echo "Step 4: Deploying simple app on spoke chain..." && \
    just deploy-simple-app "{{SPOKE_RPC_URL}}" $HUB_CHAIN_ID "{{ADDRESS_PATH}}" && \
    echo "Spoke chain deployment complete!"

deploy-simple-app RPC_URL ORIGIN_CHAIN_ID ADDRESS_PATH="./devnet-addresses.json":
    export CHAIN_ID=$(just chain-id "{{RPC_URL}}") && \
    export MAILBOX_ADDRESS=$(just get-contract $CHAIN_ID Mailbox "{{ADDRESS_PATH}}") && \
    export ISM_ADDRESS=$(just get-contract $CHAIN_ID PolymerISM_{{ORIGIN_CHAIN_ID}} "{{ADDRESS_PATH}}") && \
    forge script script/DeploySimpleMessageSenderReceiver.s.sol:DeploySimpleMessageSenderReceiver \
        --rpc-url "{{RPC_URL}}" \
        --broadcast \
        -vvvv | tee /tmp/deploy-SimpleMessageSenderReceiver.txt && \
    echo "Simple app deployed at: $(grep -o 'new SimpleMessageSenderReceiver@0x[a-fA-F0-9]*' /tmp/deploy-SimpleMessageSenderReceiver.txt | cut -d'@' -f2)"
    just save-contract-address "{{RPC_URL}}" "SimpleMessageSenderReceiver_{{ORIGIN_CHAIN_ID}}" "SimpleMessageSenderReceiver" "SimpleMessageSenderReceiver" "{{ADDRESS_PATH}}"

save-contract-address RPC_URL CONTRACT_NAME DEPLOY_FILE_NAME CONTRACT_PATTERN ADDRESS_PATH="./devnet-addresses.json":
    export CONTRACT_ADDRESS=$(just _get-latest-address {{DEPLOY_FILE_NAME}} {{CONTRACT_PATTERN}}) && \
    export CHAIN_ID=$(just chain-id "{{RPC_URL}}") && \
    jq --arg address "$CONTRACT_ADDRESS" \
       --arg chain_id "$CHAIN_ID" \
       --arg contract_name "{{CONTRACT_NAME}}" \
       '.[$chain_id] |= ( . + {($contract_name): $address} )' "{{ADDRESS_PATH}}" > "{{ADDRESS_PATH}}.tmp" && mv "{{ADDRESS_PATH}}.tmp" "{{ADDRESS_PATH}}"




get-contract CHAIN_ID CONTRACT_NAME ADDRESS_PATH="./devnet-addresses.json":
    @cat "{{ADDRESS_PATH}}" | jq -r --arg chain_id "{{CHAIN_ID}}" '.[$chain_id].{{CONTRACT_NAME}}'

_get-latest-address DEPLOY_FILE_NAME CONTRACT_PATTERN:
    @grep -o "new {{CONTRACT_PATTERN}}@0x[a-fA-F0-9]*" /tmp/deploy-{{DEPLOY_FILE_NAME}}.txt | head -1 | cut -d'@' -f2 || echo "No {{CONTRACT_PATTERN}} address found. Run deploy-{{CONTRACT_PATTERN}} first."

